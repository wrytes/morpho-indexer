# Port (default: 42069)
PORT=42069
ALCHEMY_RPC_KEY=...

# (Optional) per-chain RPC override, takes precedence over Alchemy
# RPC_URL_1=
# RPC_URL_8453=

# (Optional) Postgres database URL. If not provided, SQLite will be used.
# DATABASE_URL=postgresql://user:pass@host:5432/db

# Indexing control
MAX_REQUESTS_PER_SECOND=10
POLLING_INTERVAL_MS=10000 # in ms
